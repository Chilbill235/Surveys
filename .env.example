# Copy this file to .env and fill in the values. Never commit .env.
# Every line below is safe to paste as-is; the app boots with them unset and reports
# clearly what is missing.

# ---------------------------------------------------------------- runtime
NODE_ENV=development
PORT=3000

# Public HTTPS origin. Providers post payment confirmations to this host, so a
# wrong value means a customer pays and the balance is never credited.
# In production the server refuses to start without it.
APP_BASE_URL=http://localhost:3000

# Trust X-Forwarded-For so per-IP rate limiting sees the real client address.
# Defaults to true on Vercel, false everywhere else. Setting it true while running
# directly on the internet lets a client spoof its address and bypass rate limits.
TRUST_PROXY=false

# ---------------------------------------------------------------- database
# PostgreSQL connection string (Neon, Supabase, RDS, ...).
DATABASE_URL=

# Provider CA certificate in PEM form. Environment variables cannot hold real
# newlines, so \n escapes are expanded. Setting this enables certificate
# verification; without it the connection is encrypted but unverified, which is
# what managed providers require unless the CA is supplied.
DATABASE_CA_CERT=

# Set to "disable" to turn TLS off. Leave blank to keep TLS on.
DATABASE_SSL=

DATABASE_POOL_MAX=20

# ---------------------------------------------------------------- sessions
# Long random value that signs session tokens. At least 32 characters.
# Required in production. Generate with: openssl rand -hex 32
JWT_SECRET=

# ---------------------------------------------------------------- security
# Shared secret for advertiser postbacks. Required in production.
POSTBACK_SECRET=

# VPN/proxy fraud checks on click tracking. Requests are rejected in production
# when this is missing.
PROXYCHECK_KEY=

# Protects the scheduled deposit reconciliation endpoint. Required for
# /api/maintenance/reconcile-deposits to work; without it the route answers 503.
# Vercel Cron sends it as `Authorization: Bearer $CRON_SECRET`.
# Generate with: openssl rand -hex 32
CRON_SECRET=675ed83acebb987fd4ebae02452c213036e9fd788a149bcd7ba93de7c9e31860

# Extra browser origins allowed to call the API, comma separated.
CORS_ORIGIN=

# ---------------------------------------------------------------- card deposits
# Both are required for card deposits to appear as available.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------- crypto deposits
# All three are required for crypto deposits to appear as available.
NOWPAYMENTS_API_KEY=3619RH1-BED4185-PMA4JQX-FB63968
NOWPAYMENTS_IPN_SECRET=tEGmITfaEKW6fxMyp4X9eZSfaBgMTxrw
# Defaults to https://api.nowpayments.io. In production the server refuses to use
# any other host, because the API key is sent to whatever address is configured here.
NOWPAYMENTS_API_BASE_URL=https://api.nowpayments.io

# Optional payment-creation behaviour, both documented on POST /v1/payment.
# Locking the rate stops the amount of crypto the customer must send drifting while
# they are copying down the address. Leaving it off lets the provider re-quote.
NOWPAYMENTS_FIXED_RATE=false
# When true the quoted crypto amount already includes the network fee, so the customer
# pays a little more crypto to cover a flat USD amount. When false the fee is taken
# out of the merchant's side and the customer must send slightly more than quoted.
NOWPAYMENTS_FEE_PAID_BY_USER=false

# ---------------------------------------------------------------- NOWPayments payouts
# Required only for the crypto payout endpoints (`POST /v1/payout`, `GET /v1/payout/fee`
# is readable with the API key alone). `POST /v1/auth` exchanges these for a JWT that
# expires after 5 minutes; the server caches and refreshes that token itself.
# Email and password are case-sensitive.
# Withdrawal requests are still stored and reviewed manually: nothing is sent for you.
NOWPAYMENTS_EMAIL=wakaflockkay@gmail.com		
NOWPAYMENTS_PASSWORD=@Fettywap12

# ---------------------------------------------------------------- payouts
# Withdrawal requests are stored and reviewed manually. Nothing is sent
# automatically, so these are not yet wired to a payout provider.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# ---------------------------------------------------------------- email
# Both are required for password reset emails to be delivered.
RESEND_API_KEY=
EMAIL_FROM=

# ---------------------------------------------------------------- misc
# Click ID parameter sent to advertisers. Defaults to aff_sub.
TRACKING_CLICK_PARAM=aff_sub

# ---------------------------------------------------------------- tests
# Only used by the live integration test suite, which is skipped unless this is
# set. Point it at a disposable database: the suite refuses to run against the
# same database as DATABASE_URL. A Neon branch is ideal.
TEST_DATABASE_URL=
